# Antigravity Backend — Environment Variables
# Copy to .env and fill in values

# Bright Data API key (from https://brightdata.com/cp/setting/users)
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Cohere API key (from https://dashboard.cohere.com/api-keys — free tier)
COHERE_API_KEY=your_cohere_api_key_here

# Groq API key (from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq model
GROQ_MODEL=openai/gpt-oss-120b

# Cohere embedding model
COHERE_EMBED_MODEL=embed-english-v3.0

# ChromaDB persistence directory
CHROMA_DB_PATH=./chroma_db

# Knowledge graph persistence file
GRAPH_PATH=./graph.json

# Backend port
PORT=8000

# CORS allowed origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Optional: max pages to scrape per site
MAX_PAGES=50
